@model OneCommerce.MVC.Models.Produit

@{
    ViewData["Title"] = "Create";
}

<h1>Ajouter</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" data-depot-image="@Url.Action("LienImage")">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_ChampsProduit" model="Model" />
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Vedette" /> @Html.DisplayNameFor(model => model.Vedette)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Enregistrer" class="btn btn-primary" /> |
                <a asp-action="Index" class="btn btn-outline-secondary">Liste des produits</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/depot-image.js" asp-append-version="true"></script>
}
