@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model IEnumerable<Produit>

@{
    ViewData["Title"] = "Home Page";

    Produit produitVedette = Model.Single(p => p.Vedette);

    var fichierEndpoint = Configuration["FichiersImageEndpoint"];


}

<section class="jumbotron text-center">
    <div class="container">
        <h1 class="jumbotron-heading">Produit vedette : @produitVedette.Nom</h1>
        <div class="row">
            <div class="col-md-5">
                <img class="card-img-top" src="@fichierEndpoint/images/@produitVedette.Image" data-src="holder.js/100px225?theme=thumb&bg=55595c&fg=eceeef&text=Thumbnail" alt="Card image cap">
            </div>
            <div class="col-md-7">
                <p class="lead text-muted">@produitVedette.Description</p>
                 <div class="btn-group">
                    <a asp-action="Edit" asp-controller="Produits" asp-route-id="@produitVedette.Id" class="btn btn-sm btn-outline-secondary">Modifier</a>
                    <a asp-action="Delete" asp-controller="Produits" asp-route-id="@produitVedette.Id" class="btn btn-sm btn-outline-secondary">Supprimer</a>
                    </div>
            </div>
         </div>
    </div>
</section>

<div class="d-flex justify-content-center">
    <form asp-action="Index" asp-controller="Produits" method="post">

    <div class="row g-3 align-items-center">
        <div class="col-auto">
           <p>Filtre selon le libellé</p>
        </div>
        <div class="col-auto">
                <input class="form-control" type="text" id="filtre" name="filtre"/>
        </div>
        <div class="col-auto">
            <input class="btn btn-primary" type="submit" value="Filtrer" />
        </div>
           
    </div>
</form>
</div>

<div class="album py-5 bg-light">
    <div class="container">

        <div class="row">
            @foreach (var item in Model.Where(p=>!p.Vedette))
            {
                    <div class="col-md-4">
                        <div class="card mb-4 box-shadow">
                        <h1 class="jumbotron-heading"> @item.Nom</h1>
                        <img class="card-img-top" src="@fichierEndpoint/images/@item.Image" data-src="holder.js/100px225?theme=thumb&bg=55595c&fg=eceeef&text=Thumbnail" alt="Card image cap">
                            <div class="card-body">
                            <p class="card-text">@item.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="btn-group">
                                    <a asp-action="Create" asp-controller="Commandes" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Commander</a>
                                    <a asp-action="Delete" asp-controller="Produits" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Supprimer</a>
                                    </div>
                                <small class="text-muted">@item.Prix $</small>
                                </div>
                            </div>
                        </div>
                    </div>
               
            }
        </div>
    </div>
</div>
