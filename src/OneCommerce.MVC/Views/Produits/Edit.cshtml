@model OneCommerce.MVC.Models.Produit
@using Microsoft.AspNetCore.Mvc.ViewFeatures

@{
    ViewData["Title"] = "Edit";
}

<h1>Mettre à jour</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" data-depot-image="@Url.Action("LienImage")">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" readonly class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <partial name="_ChampsProduit" model="Model" view-data="@(new ViewDataDictionary(ViewData) { { "LibelleImage", "Remplacer l'image" } })" />
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Vedette" disabled /> @Html.DisplayNameFor(model => model.Vedette)
                    <input asp-for="Vedette" hidden />
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Enregistrer" class="btn btn-primary" /> |
                <a asp-action="Index" class="btn btn-outline-secondary">Liste des produits</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/depot-image.js" asp-append-version="true"></script>
}
