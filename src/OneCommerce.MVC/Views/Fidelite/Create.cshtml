@model OneCommerce.MVC.Models.Fidelite

@{
    ViewData["Title"] = "Create";
}


<h2>Fidelite</h2>
<hr />
@if (!string.IsNullOrEmpty(ViewBag.NumeroFidelite))
{
    <div class="alert alert-info" role="alert">
        votre numéro de fidélité est : <strong>@ViewBag.NumeroFidelite</strong>.
        Veuillez le conserver précieusement.

        retourner à la <a asp-action="Index" asp-controller="Produits">page d'accueil</a>.
    </div>
}
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NomClient" class="control-label"></label>
                <input asp-for="NomClient" class="form-control" />
                <span asp-validation-for="NomClient" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CourrielClient" class="control-label"></label>
                <input asp-for="CourrielClient" class="form-control" />
                <span asp-validation-for="CourrielClient" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Telephone" class="control-label"></label>
                <input asp-for="Telephone" class="form-control" />
                <span asp-validation-for="Telephone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Enregistrer" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
